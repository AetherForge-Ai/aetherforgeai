# Keep the installed dependency tree flat and deterministic on the
# Cloudflare build container. `prefer-dedupe` avoids duplicate nested
# copies of shared transitive deps (e.g. @noble/*) that previously left
# a non-empty node_modules inside `better-auth` and triggered npm's
# `ENOTEMPTY: rename ... better-auth` reify failure during deploy.
prefer-dedupe=true
fund=false
audit=false
