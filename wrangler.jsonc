/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */ {
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totalum-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "upload_source_maps": true,
  // b7 CR-2 / CR-5: edge rate limits shared by every isolate (period must be 10 or 60 s).
  // The 5-minute sign-in window is kept by the app counter; this stops bursts.
  "ratelimits": [
    { "name": "GUIDE_RATE_LIMITER", "namespace_id": "4601", "simple": { "limit": 6, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "4602", "simple": { "limit": 10, "period": 60 } },
    // Goal b12 CR-2 / CR-5: IPv6 /48 guide bucket and the per-email sign-in bucket (no IP part).
    { "name": "GUIDE48_RATE_LIMITER", "namespace_id": "4603", "simple": { "limit": 12, "period": 60 } },
    { "name": "AUTH_EMAIL_RATE_LIMITER", "namespace_id": "4604", "simple": { "limit": 10, "period": 60 } }
  ]
}
